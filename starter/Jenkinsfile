
pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    parameters {
        choice(
            name: 'SUITE',
            choices: [
                'testng-smoke.xml',
                'testng.xml',
                'testng-parallel.xml'
            ],
            description: 'Select the TestNG suite'
        )

        booleanParam(
            name: 'HEADLESS',
            defaultValue: true,
            description: 'Run Chrome without opening a browser window'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('starter') {
                    bat 'mvn clean compile test-compile -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('starter') {
                    bat "mvn test \"-DsuiteXmlFile=${params.SUITE}\" \"-Dheadless=${params.HEADLESS}\""
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                  testResults: 'starter/target/surefire-reports/TEST-*.xml'

            allure(
                includeProperties: false,
                jdk: '',
                results: [[path: 'starter/target/allure-results']]
            )

            archiveArtifacts(
                artifacts: 'starter/target/screenshots/**/*',
                allowEmptyArchive: true
            )
        }
    }
}
